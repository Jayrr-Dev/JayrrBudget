# App — Convex is the live database (see AGENTS.md)
NEXT_PUBLIC_CONVEX_URL=

# Polar billing lives on Convex env (not Next): POLAR_ORGANIZATION_TOKEN,
# POLAR_WEBHOOK_SECRET, POLAR_SERVER=production, optional POLAR_PREMIUM_PRODUCT_ID.

# Convex Auth keys live on the Convex dashboard (JWT_PRIVATE_KEY, JWKS).
# Google OAuth also lives on Convex env (not Next):
# SITE_URL=http://localhost:3000
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Google Cloud: Web client, JS origin = SITE_URL, redirect =
#   https://<deployment>.convex.site/api/auth/callback/google
# Password recovery email lives on Convex env (not Next):
# RESEND_API_KEY=
# RESEND_FROM=Jev's Budget <no-reply@jevsbudget.app>

# Optional: legacy Turso (scripts/ only — not the live app)
# DATABASE_URL=libsql://your-db-name-your-org.aws-us-west-2.turso.io
# DATABASE_AUTH_TOKEN=

# Manual statement import / canvas AI (server-only keys)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# 32-byte wrap key for user BYOK (openssl rand -base64 32). Required to save a personal OpenRouter key.
AI_BYOK_WRAP_KEY=
# Used only if no default model is saved on /service.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.3-flash,openai/gpt-oss-120b
