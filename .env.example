# App
DATABASE_URL=file:./data/jayrr-budget.db
# For Vercel production, use Turso (SQLite-compatible) instead of a local file:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Plaid (https://dashboard.plaid.com)
# Set to false to hide Connect bank / sync UI and reject Plaid APIs
NEXT_PUBLIC_PLAID_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Manual statement import
# OCR: https://console.mistral.ai
MISTRAL_API_KEY=
# Parse via OpenRouter — modern Google Gemini lineup
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-3.7-flash,google/gemini-3.5-flash-lite,google/gemini-2.5-flash
# Or set a full ordered chain:
# OPENROUTER_MODELS=google/gemini-3.8-flash,google/gemini-3.7-flash,google/gemini-3.5-flash-lite
