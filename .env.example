# App — Convex is the live database (see AGENTS.md)
NEXT_PUBLIC_CONVEX_URL=

# Clerk (invite-only — disable public signup in Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Also set on Convex dashboard (Clerk Frontend API URL):
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: legacy Turso (scripts/ only — not the live app)
# DATABASE_URL=libsql://your-db-name-your-org.aws-us-west-2.turso.io
# DATABASE_AUTH_TOKEN=

# Manual statement import / canvas AI (server-only keys)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-3.7-flash,google/gemini-3.5-flash-lite,google/gemini-2.5-flash
